# Supabase — leave unset and the app runs fully on localStorage.
# From your project's dashboard: Settings → API. Copy this file to .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bug reports from the Help page — both optional. With Supabase set, reports are
# stored in the `feedback` table regardless. With these two, a copy is emailed.
# Resend: create a key at resend.com; the default sender works for your own inbox
# while you are testing, a verified domain is needed to mail anyone else.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=

# Map tiles — leave unset for OpenStreetMap's public tiles (fine for development and a
# small launch). Once traffic grows, point this at a keyed provider's URL template
# (MapTiler, Stadia, …) and give its required attribution.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Email — invites, nudges and reminders (see docs/phase-9-email.md).
# MAIL_FROM_EMAIL must be an address on a domain verified in Resend, e.g. "Hourelle <hello@yourdomain.com>";
# without it the sandbox sender is used, which only delivers to your own Resend account address.
MAIL_FROM_EMAIL=
# The reminder job runs on the server with no browser session, so it needs the service key
# (Settings → API → service_role; never expose it to a browser) and a secret Vercel sends
# with each cron call (any long random string; Vercel adds it as a bearer token automatically).
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Where links in emails point. Set on Vercel; locally it falls back to the request's host.
NEXT_PUBLIC_SITE_URL=
# Set to 1 once MAIL_FROM_EMAIL is on a verified domain. Until then no send buttons show.
NEXT_PUBLIC_MAIL_ON=
# Set to 1 once calendar import works end to end: the Google Calendar API and its
# calendar.freebusy scope, the Azure provider in Supabase (Calendars.Read), and Manual
# linking under Authentication > Advanced. Until then Import says "Coming soon".
NEXT_PUBLIC_CALENDAR_IMPORT_ON=

# Where "Buy me a coffee" points (a Buy Me a Coffee, Ko-fi or GitHub Sponsors page).
# Unset, the link and the About card stay hidden.
NEXT_PUBLIC_SUPPORT_URL=
